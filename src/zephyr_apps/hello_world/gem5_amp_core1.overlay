/ {
    soc {
        sram0: memory@90100000 {
            compatible = "mmio-sram";
            reg = <0x90100000 0x100000>;
        };
        
        uart_gem5_1: serial@10011000 {
            compatible = "ns16550";
            reg = <0x10011000 0x100>;
            status = "okay";
            current-speed = <115200>;
            label = "UART_1";
            reg-shift = <0>;
            clock-frequency = <100000000>;
            interrupt-parent = <&plic>;
            interrupts = <11 1>;
        };
    };

    chosen {
        zephyr,sram = &sram0;
        zephyr,console = &uart_gem5_1;
        zephyr,shell-uart = &uart_gem5_1;
    };
};



&pwm0 { status = "disabled"; };
&pwm1 { status = "disabled"; };
&pwm2 { status = "disabled"; };
&gpio0 { status = "disabled"; };
&spi0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&spi2 { status = "disabled"; };
&wdog0 { status = "disabled"; };

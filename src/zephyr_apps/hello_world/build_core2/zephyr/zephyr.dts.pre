&pinctrl {

 uart0_rx_default: uart0_rx_default {
  pinmux = <16 0x00>;
 };

 uart0_tx_default: uart0_tx_default {
  pinmux = <17 0x00>;
 };


 spi1_cs0_default: spi1_cs0_default {
  pinmux = <2 0x00>;
 };

 spi1_mosi_default: spi1_mosi_default {
  pinmux = <3 0x00>;
 };

 spi1_miso_default: spi1_miso_default {
  pinmux = <4 0x00>;
 };

 spi1_sck_default: spi1_sck_default {
  pinmux = <5 0x00>;
 };

 spi1_cs2_default: spi1_cs2_default {
  pinmux = <9 0x00>;
 };

 spi1_cs3_default: spi1_cs3_default {
  pinmux = <10 0x00>;
 };


 pwm0_0_default: pwm0_0_default {
  pinmux = <0 0x01>;
 };

 pwm0_1_default: pwm0_1_default {
  pinmux = <1 0x01>;
 };

 pwm0_2_default: pwm0_2_default {
  pinmux = <2 0x01>;
 };

 pwm0_3_default: pwm0_3_default {
  pinmux = <3 0x01>;
 };


 pwm1_0_default: pwm1_0_default {
  pinmux = <20 0x01>;
 };

 pwm1_1_default: pwm1_1_default {
  pinmux = <19 0x01>;
 };

 pwm1_2_default: pwm1_2_default {
  pinmux = <21 0x01>;
 };

 pwm1_3_default: pwm1_3_default {
  pinmux = <22 0x01>;
 };


 pwm2_0_default: pwm2_0_default {
  pinmux = <10 0x01>;
 };

 pwm2_1_default: pwm2_1_default {
  pinmux = <11 0x01>;
 };

 pwm2_2_default: pwm2_2_default {
  pinmux = <12 0x01>;
 };

 pwm2_3_default: pwm2_3_default {
  pinmux = <13 0x01>;
 };


 i2c0_0_default: i2c0_0_default {
  pinmux = <12 0x00>;
 };

 i2c0_1_default: i2c0_1_default {
  pinmux = <13 0x00>;
 };
};
# 10 "/home/ubuntu/work/gem5/gem5_riscv_rt/src/zephyr/zephyr/boards/sifive/hifive1/hifive1.dts" 2

/ {
 model = "SiFive HiFive 1";
 compatible = "sifive,hifive1";

 aliases {
  led0 = &led0;
  led1 = &led1;
  led2 = &led2;
  pwm-led0 = &pwmled0;
  pwm-led1 = &pwmled1;
  pwm-led2 = &pwmled2;
  watchdog0 = &wdog0;
 };

 chosen {
  zephyr,console = &uart0;
  zephyr,shell-uart = &uart0;
  zephyr,sram = &dtim;
  zephyr,flash = &flash0;
 };

 leds {
  compatible = "gpio-leds";

  led0: led_0 {
   gpios = <&gpio0 19 (1 << 0)>;
   label = "Green LED";
  };

  led1: led_1 {
   gpios = <&gpio0 21 (1 << 0)>;
   label = "Blue LED";
  };

  led2: led_2 {
   gpios = <&gpio0 22 (1 << 0)>;
   label = "Red LED";
  };
 };

 pwmleds {
  compatible = "pwm-leds";

  pwmled0: pwmled_0 {
   pwms = <&pwm1 1 (((20) * 1000UL) * 1000UL)>;
   label = "Green LED";
  };

  pwmled1: pwmled_1 {
   pwms = <&pwm1 2 (((20) * 1000UL) * 1000UL)>;
   label = "Blue LED";
  };

  pwmled2: pwmled_2 {
   pwms = <&pwm1 3 (((20) * 1000UL) * 1000UL)>;
   label = "Red LED";
  };
 };

 arduino_header: connector {
  compatible = "arduino-header-r3";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map =
      <1 0 &gpio0 9 0>,
      <2 0 &gpio0 10 0>,
      <3 0 &gpio0 11 0>,
      <4 0 &gpio0 12 0>,
      <5 0 &gpio0 13 0>,
      <6 0 &gpio0 16 0>,
      <7 0 &gpio0 17 0>,
      <8 0 &gpio0 18 0>,
      <9 0 &gpio0 19 0>,
      <10 0 &gpio0 20 0>,
      <11 0 &gpio0 21 0>,
      <12 0 &gpio0 22 0>,
      <13 0 &gpio0 23 0>,
      <14 0 &gpio0 0 0>,
      <15 0 &gpio0 1 0>,
      <16 0 &gpio0 2 0>,
      <17 0 &gpio0 3 0>,
      <18 0 &gpio0 4 0>,
      <19 0 &gpio0 5 0>,
      <20 0 &gpio0 12 0>,
      <21 0 &gpio0 13 0>;
 };
};

&gpio0 {
 status = "okay";
};

&uart0 {
 status = "okay";
 current-speed = <115200>;
 pinctrl-0 = <&uart0_rx_default &uart0_tx_default>;
 pinctrl-names = "default";
};


&spi0 {
 reg = <0x10014000 0x1000 0x20400000 0xc00000>;

 flash0: flash@0 {
  compatible = "issi,is25lp128", "jedec,spi-nor";
  status = "disabled";
  size = <134217728>;
  jedec-id = [96 60 18];
  reg = <0>;
  spi-max-frequency = <133000000>;
 };
};

&spi1 {
 status = "okay";
 pinctrl-0 = <&spi1_cs0_default &spi1_cs2_default &spi1_cs3_default
       &spi1_mosi_default &spi1_miso_default &spi1_sck_default>;
 pinctrl-names = "default";
};

&spi2 {
 status = "okay";
};

&pwm0 {
 status = "okay";
};

&pwm1 {
 status = "okay";
 pinctrl-0 = <&pwm1_1_default &pwm1_2_default &pwm1_3_default>;
 pinctrl-names = "default";
};

&pwm2 {
 status = "okay";
 pinctrl-0 = <&pwm2_1_default &pwm2_2_default &pwm2_3_default>;
 pinctrl-names = "default";
};

arduino_i2c: &i2c0 {
 status = "okay";
 clock-frequency = <100000>;
 pinctrl-0 = <&i2c0_0_default &i2c0_1_default>;
 pinctrl-names = "default";
};
# 0 "<command-line>" 2
# 1 "./gem5_amp_core2.overlay" 1
/ {
    soc {
        sram0: memory@90200000 {
            compatible = "mmio-sram";
            reg = <0x90200000 0x100000>;
        };

        uart_gem5_2: serial@10012000 {
            compatible = "ns16550";
            reg = <0x10012000 0x100>;
            status = "okay";
            current-speed = <115200>;
            label = "UART_2";
            reg-shift = <0>;
            clock-frequency = <100000000>;
            interrupt-parent = <&plic>;
            interrupts = <12 1>;
        };
    };

    chosen {
        zephyr,sram = &sram0;
        zephyr,console = &uart_gem5_2;
        zephyr,shell-uart = &uart_gem5_2;
    };
};

&pwm0 { status = "disabled"; };
&pwm1 { status = "disabled"; };
&pwm2 { status = "disabled"; };
&gpio0 { status = "disabled"; };
&spi0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&spi2 { status = "disabled"; };
&wdog0 { status = "disabled"; };

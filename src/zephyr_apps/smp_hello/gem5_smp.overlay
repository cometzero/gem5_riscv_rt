/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &dtim;
		zephyr,flash = &dtim;
	};
};

&uart0 {
    reg = <0x10014000 0x100>;
    interrupts = <14 1>;
    current-speed = <115200>;
    clock-frequency = <100000000>;
};

&dtim {
    reg = <0x90400000 0x400000>; /* 4MB Shared SRAM (Data) */
};

/delete-node/ &spi0;

/ {
    soc {
        flash0: memory@80000000 {
            compatible = "mmio-sram";
            reg = <0x80000000 0x800000>; /* 8MB Shared MRAM (Code) */
        };
    };
};
